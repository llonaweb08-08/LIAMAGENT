# Copy to .env for local runs, or set these in the Render dashboard.
# Never commit the real file: .env and liam_secrets.py are git-ignored.

# ---------------------------------------------------------------------------
# Paths (Render: /data is ephemeral, but Supabase restores it on every boot)
# ---------------------------------------------------------------------------
LIAM_DATA_DIR=/data
LIAM_DB=/data/liam_memory.db
PORT=5678

# ---------------------------------------------------------------------------
# WhatsApp pairing
# ---------------------------------------------------------------------------
# The bot's own number, digits only, with country code.
LIAM_BOT_PHONE=447881161023
# Long random secret for /qr and /pair. If empty, one is generated and stored
# in LIAM_DATA_DIR/pair_token (which is not archived, so it changes after a
# restart unless you set it explicitly).
LIAM_PAIR_TOKEN=
# Optional public base URL for the pairing links. Render sets this itself.
# LIAM_PUBLIC_URL=https://liam-whatsapp-agent.onrender.com

# ---------------------------------------------------------------------------
# Supabase Storage (session + SQLite persistence)
# ---------------------------------------------------------------------------
# Project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) from Supabase -> Settings -> API Keys.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=liam-session
LIAM_SUPABASE_TIMEOUT_MS=120000
LIAM_BACKUP_INTERVAL_MS=600000

# ---------------------------------------------------------------------------
# Model providers (tool-capable chain: MoonMath -> GLM -> Agnes -> HCN)
# ---------------------------------------------------------------------------
# Comma-separated key pools are rotated automatically.
MOON_KEYS=
UNO_KEYS=
AGNES_KEY=
HCN_KEY=
# Optional overrides.
# MOON_BASE=https://zro.moonmath.ai/v1
# MOON_MODEL=deepseek-v4.1-flash
# MOON_FALLBACK=glm-5.3-flash
# UNO_BASE=https://api.unorouter.com/v1
# AGNES_BASE=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-3.0-flash
# HCN_BASE=https://api.hcnsec.cn/v1
# HCN_MODEL=DeepSeek-V4-Flash

# ---------------------------------------------------------------------------
# Optional: image generation / voice notes (Google AI Studio)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: better web search. The first configured provider wins, then the
# free DuckDuckGo HTML endpoint is used as a fallback.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: InstaBox pentest VM (members need one-time owner approval)
# ---------------------------------------------------------------------------
INSTABOX_API_KEY=
INSTABOX_MACHINE_ID=
# INSTABOX_API_URL=https://api.instabox.sh

# ---------------------------------------------------------------------------
# Behaviour tuning
# ---------------------------------------------------------------------------
# 3 hours per member per group
LIAM_GROUP_PERMISSION_MS=10800000
# 10 minutes for a one-time tool approval
LIAM_TOOL_APPROVAL_MS=600000
LIAM_INIT_TIMEOUT_MS=300000
# LIAM_DM_OPEN=0
# LIAM_DM_ALLOWLIST=
# LIAM_PYTHON=/opt/venv/bin/python

# ---------------------------------------------------------------------------
# Optional: email reading (IMAP; Render free cannot send SMTP)
# ---------------------------------------------------------------------------
# LIAM_EMAIL_HOST=imap.gmail.com
# LIAM_EMAIL_USER=
# LIAM_EMAIL_PASSWORD=
# LIAM_EMAIL_FOLDER=INBOX
