# Copy to .env for local runs, or set these in the Render dashboard.
# Never commit the real file: .env and liam_secrets.py are git-ignored.

# ---------------------------------------------------------------------------
# Paths (Render: /data is ephemeral, but Supabase restores it on every boot)
# ---------------------------------------------------------------------------
LIAM_DATA_DIR=/data
LIAM_DB=/data/liam_memory.db
PORT=5678
# Only needed when the bridge is on another host/port; otherwise Python derives
# it from LIAM_PORT/PORT.
# LIAM_BRIDGE_URL=http://127.0.0.1:5678

# ---------------------------------------------------------------------------
# WhatsApp pairing
# ---------------------------------------------------------------------------
# The bot's own number, digits only, with country code.
LIAM_BOT_PHONE=447881161023
# Long random secret for /qr and /pair. If empty, one is generated and stored
# in LIAM_DATA_DIR/pair_token (which is not archived, so it changes after a
# restart unless you set it explicitly).
LIAM_PAIR_TOKEN=
# Optional public base URL for the pairing links. Render sets this itself.
# LIAM_PUBLIC_URL=https://liam-whatsapp-agent.onrender.com
# Baileys log level: silent (default), error, warn, info, debug or trace. Also
# settable at runtime with /diag?token=...&walog=trace.
# LIAM_WA_LOG=silent
# A code is reused for 60s, then WhatsApp's own cooldown applies (2 min default).
# LIAM_PAIRING_COOLDOWN_MS=120000

# ---------------------------------------------------------------------------
# Supabase Storage (session + SQLite persistence)
# ---------------------------------------------------------------------------
# Project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) from Supabase -> Settings -> API Keys.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=liam-session
LIAM_SUPABASE_TIMEOUT_MS=120000
# Backups are a safety net, not a heartbeat: the writer skips the tar/gzip and
# vacuum when nothing changed, so a longer interval costs almost nothing and
# avoids the CPU spikes that can starve the WhatsApp socket. render.yaml uses
# 30 minutes; the code default is 10 minutes.
LIAM_BACKUP_INTERVAL_MS=1800000
# Refuse to upload an archive larger than this (bytes).
# LIAM_MAX_ARCHIVE_BYTES=314572800

# ---------------------------------------------------------------------------
# Model providers (tool-capable chain: MoonMath -> Agnes -> HCN)
# ---------------------------------------------------------------------------
# Comma-separated key pools are rotated automatically.
MOON_KEYS=
UNO_KEYS=
AGNES_KEY=
HCN_KEY=
# Optional overrides.
# MOON_BASE=https://zro.moonmath.ai/v1
# MOON_MODEL=deepseek-v4.1-flash
# MOON_FALLBACK=            # empty by default; the old glm-5.3-flash now 404s
# UNO_BASE=https://api.unorouter.com/v1
# AGNES_BASE=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-3.0-flash
# HCN_BASE=https://api.hcnsec.cn/v1
# HCN_MODEL=auto
# Unorouter is chat-only and is never used implicitly; ask for it by name.
# Hugging Face is no longer used because the public router rejected the models.
# HF_KEY=
# HF_BASE=https://router.huggingface.co/v1

# ---------------------------------------------------------------------------
# Optional: image generation / voice notes (Google AI Studio)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
# LIAM_IMAGE_MODEL=gemini-2.5-flash-image-preview
# LIAM_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---------------------------------------------------------------------------
# Optional: better web search. The first configured provider wins, then the
# free DuckDuckGo HTML endpoint is used as a fallback.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: InstaBox pentest VM (members need one-time owner approval)
# ---------------------------------------------------------------------------
INSTABOX_API_KEY=
# Optional: leave unset and Liam uses the first machine in the workspace, or
# creates one from the agent-browser template if the workspace has none.
INSTABOX_MACHINE_ID=
# INSTABOX_API_URL=https://api.instabox.sh
# Where the VM keeps browser scripts and the --target Playwright install.
# LIAM_VPS_BROWSER_DIR=/data/home/liam_browser
# LIAM_VPS_PYLIB_DIR=/data/home/liam_pylibs
# INSTABOX_PYLIB_DIR=/data/home/liam_pylibs
# Run headless Chromium on the VM (1, default) or in this container (0).
# LIAM_VPS_BROWSER=1

# ---------------------------------------------------------------------------
# Behaviour tuning (defaults shown; set only to change them)
# ---------------------------------------------------------------------------
# How long the bridge waits for one agent turn before giving up (ms).
# LIAM_ASK_TIMEOUT_MS=240000
# The agent's own per-turn work budget, in seconds.
# LIAM_TURN_BUDGET=120
# Remote browser task and screenshot timeouts, in seconds.
# LIAM_BROWSER_TIMEOUT=90
# LIAM_SCREENSHOT_TIMEOUT=75
# 3 hours per member per group.
LIAM_GROUP_PERMISSION_MS=10800000
# How long an unanswered permission prompt stays valid.
# LIAM_PENDING_TTL_MS=1800000
# 10 minutes for a one-time tool approval.
LIAM_TOOL_APPROVAL_MS=600000
LIAM_INIT_TIMEOUT_MS=300000
# Owner-only local shell/file tools, in seconds.
# LIAM_SHELL_TIMEOUT=30
# web_fetch timeout, in seconds.
# LIAM_FETCH_TIMEOUT=20
# Recycle the WhatsApp socket before this memory use (MiB). Unset disables it.
# LIAM_MEM_LIMIT_MB=400
# How often the bridge pings WhatsApp; shorter is safer on a busy box (ms).
# LIAM_WA_KEEPALIVE_MS=25000
# Self-ping so a free instance does not sleep (ms). LIAM_DISABLE_KEEPALIVE=1 off.
# LIAM_KEEPALIVE_MS=600000
# DM policy. LIAM_DM_OPEN=1 opens DMs to everyone Liam has seen; 0 (default) is
# owners/admins only. LIAM_DM_ALLOWLIST adds extra numbers, comma-separated.
# LIAM_DM_OPEN=0
# LIAM_DM_ALLOWLIST=
# LIAM_PYTHON=/opt/venv/bin/python

# ---------------------------------------------------------------------------
# Optional: email reading (IMAP; Render free cannot send SMTP)
# ---------------------------------------------------------------------------
# LIAM_EMAIL_HOST=imap.gmail.com
# LIAM_EMAIL_PORT=993
# LIAM_EMAIL_USER=
# LIAM_EMAIL_PASSWORD=
# LIAM_EMAIL_FOLDER=INBOX
# LIAM_EMAIL_TIMEOUT=20
